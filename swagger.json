{
  "openapi": "3.0.0",
  "info": {
    "title": "RecipeBox API",
    "description": "API documentation for the RecipeBox project.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/",
      "description": "Current server"
    }
  ],
  "tags": [
    {
      "name": "Recipes",
      "description": "Recipe endpoints"
    },
    {
      "name": "Categories",
      "description": "Category endpoints"
    }
  ],
  "paths": {
    "/recipes": {
      "get": {
        "tags": ["Recipes"],
        "summary": "Get all recipes",
        "description": "Returns all recipes stored in the database.",
        "responses": {
          "200": {
            "description": "A list of recipes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Recipe"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Server error"
          }
        }
      },
      "post": {
        "tags": ["Recipes"],
        "summary": "Create a new recipe",
        "description": "Creates a new recipe document in MongoDB.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecipeInput"
              },
              "example": {
                "title": "Chicken Alfredo",
                "description": "Creamy pasta with chicken",
                "ingredients": ["chicken", "fettuccine", "cream", "parmesan"],
                "instructions": "Cook pasta. Cook chicken. Make sauce. Combine everything.",
                "prepTime": 15,
                "cookTime": 25,
                "servings": 4,
                "difficulty": "easy",
                "category": "dinner"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Recipe created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Recipe"
                }
              }
            }
          },
          "400": {
            "description": "Invalid recipe data"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/recipes/{id}": {
      "get": {
        "tags": ["Recipes"],
        "summary": "Get one recipe by ID",
        "description": "Returns one recipe by its MongoDB ObjectId.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "MongoDB ObjectId of the recipe",
            "schema": {
              "type": "string",
              "example": "665f123abc123abc123abc12"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Recipe found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Recipe"
                }
              }
            }
          },
          "400": {
            "description": "Invalid recipe ID format"
          },
          "404": {
            "description": "Recipe not found"
          },
          "500": {
            "description": "Server error"
          }
        }
      },
      "put": {
        "tags": ["Recipes"],
        "summary": "Update one recipe by ID",
        "description": "Updates an existing recipe by its MongoDB ObjectId.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "MongoDB ObjectId of the recipe",
            "schema": {
              "type": "string",
              "example": "665f123abc123abc123abc12"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecipeInput"
              },
              "example": {
                "title": "Updated Chicken Alfredo",
                "description": "Updated creamy pasta recipe with chicken",
                "ingredients": ["chicken", "fettuccine", "cream", "parmesan", "garlic"],
                "instructions": "Cook pasta. Cook chicken. Make sauce. Combine everything and serve warm.",
                "prepTime": 20,
                "cookTime": 30,
                "servings": 4,
                "difficulty": "medium",
                "category": "dinner"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Recipe updated successfully"
          },
          "400": {
            "description": "Invalid recipe data or ID format"
          },
          "404": {
            "description": "Recipe not found"
          },
          "500": {
            "description": "Server error"
          }
        }
      },
      "delete": {
        "tags": ["Recipes"],
        "summary": "Delete one recipe by ID",
        "description": "Deletes an existing recipe by its MongoDB ObjectId.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "MongoDB ObjectId of the recipe",
            "schema": {
              "type": "string",
              "example": "665f123abc123abc123abc12"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Recipe deleted successfully"
          },
          "400": {
            "description": "Invalid recipe ID format"
          },
          "404": {
            "description": "Recipe not found"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/categories": {
      "get": {
        "tags": ["Categories"],
        "summary": "Get all categories",
        "description": "Returns all recipe categories stored in the database.",
        "responses": {
          "200": {
            "description": "A list of categories",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Category"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Server error"
          }
        }
      },
      "post": {
        "tags": ["Categories"],
        "summary": "Create a new category",
        "description": "Creates a new recipe category document.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CategoryInput"
              },
              "example": {
                "name": "dinner",
                "description": "Main meal recipes"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Category created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Category"
                }
              }
            }
          },
          "400": {
            "description": "Invalid category data"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/categories/{id}": {
      "put": {
        "tags": ["Categories"],
        "summary": "Update one category by ID",
        "description": "Updates an existing category by its MongoDB ObjectId.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "MongoDB ObjectId of the category",
            "schema": {
              "type": "string",
              "example": "665f456abc456abc456abc45"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CategoryInput"
              },
              "example": {
                "name": "lunch",
                "description": "Midday meal recipes"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Category updated successfully"
          },
          "400": {
            "description": "Invalid category data or ID format"
          },
          "404": {
            "description": "Category not found"
          },
          "500": {
            "description": "Server error"
          }
        }
      },
      "delete": {
        "tags": ["Categories"],
        "summary": "Delete one category by ID",
        "description": "Deletes an existing category by its MongoDB ObjectId.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "MongoDB ObjectId of the category",
            "schema": {
              "type": "string",
              "example": "665f456abc456abc456abc45"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Category deleted successfully"
          },
          "400": {
            "description": "Invalid category ID format"
          },
          "404": {
            "description": "Category not found"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Recipe": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "example": "665f123abc123abc123abc12"
          },
          "title": {
            "type": "string",
            "example": "Chicken Alfredo"
          },
          "description": {
            "type": "string",
            "example": "Creamy pasta with chicken"
          },
          "ingredients": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": ["chicken", "fettuccine", "cream", "parmesan"]
          },
          "instructions": {
            "type": "string",
            "example": "Cook pasta. Cook chicken. Make sauce. Combine everything."
          },
          "prepTime": {
            "type": "number",
            "example": 15
          },
          "cookTime": {
            "type": "number",
            "example": 25
          },
          "servings": {
            "type": "number",
            "example": 4
          },
          "difficulty": {
            "type": "string",
            "enum": ["easy", "medium", "hard"],
            "example": "easy"
          },
          "category": {
            "type": "string",
            "enum": [
              "breakfast",
              "lunch",
              "dinner",
              "dessert",
              "snack",
              "drink"
            ],
            "example": "dinner"
          },
          "createdBy": {
            "type": "string",
            "example": "placeholder-user"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "RecipeInput": {
        "type": "object",
        "required": [
          "title",
          "description",
          "ingredients",
          "instructions",
          "prepTime",
          "cookTime",
          "servings",
          "difficulty",
          "category"
        ],
        "properties": {
          "title": {
            "type": "string",
            "example": "Chicken Alfredo"
          },
          "description": {
            "type": "string",
            "example": "Creamy pasta with chicken"
          },
          "ingredients": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": ["chicken", "fettuccine", "cream", "parmesan"]
          },
          "instructions": {
            "type": "string",
            "example": "Cook pasta. Cook chicken. Make sauce. Combine everything."
          },
          "prepTime": {
            "type": "number",
            "example": 15
          },
          "cookTime": {
            "type": "number",
            "example": 25
          },
          "servings": {
            "type": "number",
            "example": 4
          },
          "difficulty": {
            "type": "string",
            "enum": ["easy", "medium", "hard"],
            "example": "easy"
          },
          "category": {
            "type": "string",
            "enum": [
              "breakfast",
              "lunch",
              "dinner",
              "dessert",
              "snack",
              "drink"
            ],
            "example": "dinner"
          }
        }
      },
      "Category": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "example": "665f456abc456abc456abc45"
          },
          "name": {
            "type": "string",
            "enum": [
              "breakfast",
              "lunch",
              "dinner",
              "dessert",
              "snack",
              "drink"
            ],
            "example": "dinner"
          },
          "description": {
            "type": "string",
            "example": "Main meal recipes"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CategoryInput": {
        "type": "object",
        "required": ["name", "description"],
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "breakfast",
              "lunch",
              "dinner",
              "dessert",
              "snack",
              "drink"
            ],
            "example": "dinner"
          },
          "description": {
            "type": "string",
            "example": "Main meal recipes"
          }
        }
      }
    }
  }
}
